function(devhub_configure_warnings target)
    if(MSVC)
        target_compile_options(${target} INTERFACE /W4 /permissive- /Zc:__cplusplus)
        if(DEVHUB_WARNINGS_AS_ERRORS)
            target_compile_options(${target} INTERFACE /WX)
        endif()
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
        target_compile_options(${target} INTERFACE -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion)
        if(DEVHUB_WARNINGS_AS_ERRORS)
            target_compile_options(${target} INTERFACE -Werror)
        endif()
    endif()
endfunction()
